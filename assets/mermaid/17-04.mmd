    F -->|"tool_calls"| H["解析工具调用 → ToolRegistry.execute()<br/>→ 记录历史 → 追加 tool message"]
    H -.->|"进入下一轮"| C

    style A fill:#e3f2fd,stroke:#1565c0
    style G fill:#e8f5e9,stroke:#2e7d32,stroke-width:2px
    style D fill:#ffebee,stroke:#c62828
