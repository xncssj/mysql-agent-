flowchart TD
    LAG{"Seconds_Behind_Master > 0?"}

    LAG -->|No| HEALTH["✅ 健康"]
    LAG -->|Yes| IO["Slave_IO_Running = No?"]

    IO -->|Yes| RP01["RP01: IO 线程停止<br/>检查网络/权限/binlog"]
    IO -->|No| SQL["Slave_SQL_Running = No?"]

    SQL -->|Yes| RP02["RP02: SQL 线程停止<br/>分析 Last_SQL_Error<br/>skip 或 rebuild"]
    SQL -->|No| RELAY["Relay Log 堆积<br/>read_pos - exec_pos > 100MB?"]

    RELAY -->|Yes| BOTTLENECK["SQL 线程回放瓶颈"]
    BOTTLENECK --> CPU["从库 CPU/IO 高?"]
    BOTTLENECK --> TXN["大事务 binlog?"]
    BOTTLENECK --> PARA["并行复制未开?"]

    CPU -->|Yes| A1["升级从库规格"]
    TXN -->|Yes| A2["RP08: 拆分大事务"]
    PARA -->|Yes| A3["RP09: 设置 slave_parallel_workers"]

    RELAY -->|No| WRITE["主库写入突增<br/>+ CC07 命中?"]
    WRITE -->|Yes| A4["从库跟不上写入峰值<br/>考虑临时限流"]
    WRITE -->|No| GTID["GTID 不一致?"]

    GTID -->|Yes| RP06["RP06: 数据不一致<br/>禁止直接 skip"]
    GTID -->|No| MONITOR["持续监控"]

    style HEALTH fill:#e8f5e9,stroke:#2e7d32,stroke-width:2px
    style RP01 fill:#ffebee,stroke:#c62828,stroke-width:2px
    style RP02 fill:#ffebee,stroke:#c62828,stroke-width:2px
    style RP06 fill:#ffebee,stroke:#c62828,stroke-width:2px
