flowchart TD
    A["异常事件"] --> B{"预热期?\n实例启动 < 24h"}
    B -->|"是"| C["过滤: 新实例不告警"]
    B -->|"否"| D{"维护窗口?\n在维护时间段内?"}
    D -->|"是"| E["过滤: 维护期间不告警"]
    D -->|"否"| F{"连续异常?\n连续 N 次异常?"}
    F -->|"否"| G["过滤: 单次异常不告警"]
    F -->|"是"| H["通过: 确认为真实异常"]

    style C fill:#e8f5e9,stroke:#2e7d32
    style E fill:#e8f5e9,stroke:#2e7d32
    style G fill:#e8f5e9,stroke:#2e7d32
    style H fill:#ffebee,stroke:#c62828,stroke-width:2px
